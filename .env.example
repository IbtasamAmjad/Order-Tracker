# Copy to .env.local (development) or set these on the server.
# The password Anas types to sign in to /admin:
ADMIN_PASSWORD=change-me
# Random text (32+ characters) used to sign the login cookie. Changing it signs everyone out:
SESSION_SECRET=change-me-to-a-long-random-text
# The public address of the site. WhatsApp messages contain the masters' links built from this:
APP_URL=http://localhost:3000
# Optional: where the database and uploaded photos live
# DATABASE_URL=./data/app.db
# UPLOAD_DIR=./data/uploads
# Optional: where the nightly backup goes (default: the backups folder in the project), and a second place for a copy
# BACKUP_DIR=D:\OrderManagerBackups
# BACKUP_DIR_2=E:\OrderManagerBackups

# On the client machine with https on the same port (deploy/linux/setup-https.sh) this becomes, for example:
# APP_URL=https://orders.labtasks.com:3002
